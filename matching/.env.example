# Copy this file to matching/.env and fill in your own key:
#   cp matching/.env.example matching/.env     (from the repository root)
#
# .env is git-ignored. Never commit a real key.

# Required for the model stage. With no key the matcher still runs - it ranks
# deterministically and labels the output `source: fallback`.
DEEPSEEK_API_KEY=
MATCH_MODEL=deepseek:deepseek-chat

# Required - the app has no SQLite fallback. Use your own PostgreSQL instance
# and never commit the URL (this file is an example only).
#   Format: postgresql://USER:PASSWORD@HOST/DATABASE
# On a deployed host, set DATABASE_URL in the provider's dashboard instead.
DATABASE_URL=

# Create the tables once, then load the 30 demo profiles:
#   psql "$DATABASE_URL" -f matching/schema.sql
#   python matching/seed.py            (idempotent, safe to re-run)

ALLOWED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001,https://ailt9019-frontend.onrender.com,https://191325-smy.github.io

SESSION_TTL_SECONDS=3600

# For the current Flash API, set MATCH_MODEL explicitly (default: deepseek:deepseek-chat):
# MATCH_MODEL=deepseek:deepseek-flash
