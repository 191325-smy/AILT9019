# Copy this file to matching/.env and fill in your own key:
#   cp matching/.env.example matching/.env     (from the repository root)
#
# .env is git-ignored. Never commit a real key.

# Required for the model stage. With no key the matcher still runs - it ranks
# deterministically and labels the output `source: fallback`.
DEEPSEEK_API_KEY=

# Optional. Defaults to deepseek:deepseek-chat when the key above is present.
# Use a chat model here, not deepseek-reasoner: the reasoner has no tool calling.
# MATCH_MODEL=deepseek:deepseek-chat
# For the current Flash API, set explicitly (the default above is unchanged):
# MATCH_MODEL=deepseek:deepseek-flash

# Optional. Where the SQLite file lives. Defaults to ailt9019.db beside the code.
# DB_PATH=ailt9019.db
