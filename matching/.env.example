# Copy this file to .env and fill in your own key:
#   cp .env.example .env
#
# .env is git-ignored. Never commit a real key.

# Required for the model stage. With no key the matcher still runs - it ranks
# deterministically and labels the output `source: fallback`.
DEEPSEEK_API_KEY=

# Defaults to deepseek:deepseek-flash when the key above is present.
# Structured output uses tool calling with thinking disabled.
# Official model names: https://api-docs.deepseek.com/quick_start/agent_integrations/
MATCH_MODEL=deepseek:deepseek-flash

# Optional. Where the SQLite file lives. Defaults to ailt9019.db beside the code.
# DB_PATH=ailt9019.db
